# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Node / dashboard (dashboard/ has its own .gitignore for its own build
# artifacts; these top-level entries catch the same paths when run from
# the repo root)
dashboard/node_modules/
dashboard/.next/
dashboard/.runstate/
dashboard/*.tsbuildinfo
dashboard/next-env.d.ts

# Generated pipeline artifacts -- reproducible from source via the
# scripts in scripts/, not source code. Immutable/timestamped and can
# grow large and numerous with routine use, so they don't belong in
# version control (see CLAUDE.md's "Raw source data should be preserved
# whenever practical" -- that's what these directories already do on
# disk; git isn't the right tool for that kind of high-churn generated
# data). Reintroduce a specific file with `git add -f` if you ever want
# one committed as a fixture.
/research_output/
/predictions/
/ownership_predictions/
/dfs_input/
/lineups/
/evaluations/
/ownership_evaluations/
/actual_ownership/
/results/
/external_projection_snapshots/
/adjusted_projection_snapshots/
/game_environment_snapshots/
/ai_projection_snapshots/
/native_projection_snapshots/
/fantasypros_snapshots/

# BlueCollar Live Projection Integration -- reproducible by re-running
# scripts/fetch_bluecollar_projections.py against the live BlueCollar
# DFS API, never source. See bluecollar/.
/bluecollar_projection_snapshots/

# Canonical MLB Player Identity Foundation -- reproducible by re-running
# scripts/refresh_player_identity.py against the live MLB Stats API,
# never source. See player_identity/.
/player_identity_snapshots/
/player_identity_crosswalk/

# Milestone 32.2B: Big Money ML SHADOW pitcher projection snapshots --
# reproducible by re-running scripts/run_ml_shadow_inference.py, never
# source. See big_money_ml/.
/ml_projection_snapshots/

# Milestone 32.5: Big Money ML forward RESULTS + LINEUP GRADING documents --
# reproducible by re-running scripts/collect_ml_forward_results.py against
# real MLB results, never source. See evaluation/ml_forward_persistence.py.
/ml_forward_results/

# Live, mutable dashboard-controlled settings (Milestone 19's Mock Mode
# toggle) -- local runtime state, not a reproducible artifact or source.
/runtime_settings/

# local external-API response cache (e.g. data/cache/mlb_stats/) -- large,
# reproducible by re-fetching, not source. data/sample_pitchers.json itself
# (a small fixture referenced by services/pitcher_data.py) stays tracked.
/data/cache/

# Milestone 31.0: raw FantasyData/SportsDataIO audit responses --
# reproducible by re-fetching from a paid subscription, never source.
/data/fantasydata/

# Milestone 31.2: raw + normalized DraftKings unofficial-provider
# snapshots -- reproducible by re-fetching from DraftKings' public
# (unauthenticated) endpoints, never source. See draftkings_unofficial/.
/data/draftkings_unofficial/

# M2B/M2G: canonical shadow-ingestion RAW/NORMALIZED artifacts (local
# LocalArtifactStorage backend only -- production uses S3ArtifactStorage,
# never this local tree) -- reproducible by re-running the canonical
# ingestion pipeline (canonical_ingestion/), never source. Same reason
# as every other generated-artifact entry above.
/raw/
/normalized/

# Milestone 32.0: historical MLB research/proof-of-concept output --
# reproducible by re-running scripts/run_historical_poc_join.py against
# live sources, never source. See historical_mlb/.
/data/historical/

# Milestone 32.2: trained model artifacts (model.joblib, metrics,
# feature importance, etc.) -- reproducible by re-running
# `python -m historical_models.pitcher_v1.train` against the warehouse,
# never source. See historical_models/.
/data/models/

# env files -- never commit secrets (DFS_SALARY_PROVIDER / DFS_PROVIDER_API_KEY, etc.)
.env
.env.*

# OS / editor
.DS_Store
*.pem
